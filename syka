    if lv.Y > 0.02 then
        local corrected = CFrame.new(cam.CFrame.Position, cam.CFrame.Position + Vector3.new(lv.X, lv.Y - 0.02, lv.Z))
        cam.CFrame = cam.CFrame:Lerp(corrected, 0.5)
    end
end)

