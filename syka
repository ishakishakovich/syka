    knob.Position = def and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
    knob.BackgroundColor3 = Color3.fromRGB(240, 240, 240); knob.Parent = ind
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
