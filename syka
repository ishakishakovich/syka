-- ===== BHOP (CS:GO) + AUTO STRAFE =====
local lastYaw = 0
local lastYawDelta = 0
RS.Heartbeat:Connect(function(dt)
    if not Cfg.Bhop then return end
    local ch = LP.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end

    local onGround = (hum.FloorMaterial ~= Enum.Material.Air)
    local holding = UIS:IsKeyDown(Enum.KeyCode.Space)

    if not onGround then
        local vel = hrp.AssemblyLinearVelocity
        local horiz = Vector3.new(vel.X, 0, vel.Z)
        local look = cam.CFrame.LookVector
        local right = cam.CFrame.RightVector
        local wish = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then wish += Vector3.new(look.X, 0, look.Z) end
        if UIS:IsKeyDown(Enum.KeyCode.S) then wish -= Vector3.new(look.X, 0, look.Z) end
        if UIS:IsKeyDown(Enum.KeyCode.A) then wish -= Vector3.new(right.X, 0, right.Z) end
        if UIS:IsKeyDown(Enum.KeyCode.D) then wish += Vector3.new(right.X, 0, right.Z) end

        -- Auto Strafe: добавляет скорость перпендикулярно движению при повороте мыши
        if Cfg.AutoStrafe then
            local yaw = math.atan2(look.X, look.Z)
            local delta = yaw - lastYaw
            if delta > math.pi then delta -= 2*math.pi elseif delta < -math.pi then delta += 2*math.pi end
            lastYawDelta = delta
            lastYaw = yaw
            if math.abs(delta) > 0.001 and horiz.Magnitude > 1 then
                local moveDir = horiz.Unit
                local perp = Vector3.new(-moveDir.Z, 0, moveDir.X)
                if delta < 0 then perp = -perp end
                horiz = horiz + perp * (math.abs(delta) * Cfg.AutoStrafePower * 100 * dt)
            end
        end

        if wish.Magnitude > 0 and horiz.Magnitude < Cfg.BhopMaxSpeed then
            local add = wish.Unit * (horiz.Magnitude * (Cfg.BhopGain - 1) + 0.6)
            local newVel = horiz + add
            if newVel.Magnitude > Cfg.BhopMaxSpeed then newVel = newVel.Unit * Cfg.BhopMaxSpeed end
            hrp.AssemblyLinearVelocity = Vector3.new(newVel.X, vel.Y, newVel.Z)
        elseif horiz.Magnitude > 0 then
            hrp.AssemblyLinearVelocity = Vector3.new(horiz.X, vel.Y, horiz.Z)
        end
    else
        lastYaw = math.atan2(cam.CFrame.LookVector.X, cam.CFrame.LookVector.Z)
        if holding then
            local vel = hrp.AssemblyLinearVelocity
            local horiz = Vector3.new(vel.X, 0, vel.Z)
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
            task.delay(0.01, function()
                if hrp and hrp.Parent then
                    local v = hrp.AssemblyLinearVelocity
                    hrp.AssemblyLinearVelocity = Vector3.new(horiz.X, v.Y, horiz.Z)
                end
            end)
        end
    end
end)

