-- ===== BHOP (CS:GO style) =====
local bhopSpeed = 0
RS.Heartbeat:Connect(function()
    if not Cfg.Bhop then return end
    local ch = LP.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end
    if UIS:IsKeyDown(Enum.KeyCode.Space) then
        local vel = hrp.AssemblyLinearVelocity
        local horiz = Vector3.new(vel.X, 0, vel.Z)
        if horiz.Magnitude > bhopSpeed then bhopSpeed = horiz.Magnitude end
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
        if hum.FloorMaterial ~= Enum.Material.Air and bhopSpeed > 0 then
            hrp.AssemblyLinearVelocity = Vector3.new(
                horiz.Unit.X * bhopSpeed, hrp.AssemblyLinearVelocity.Y, horiz.Unit.Z * bhopSpeed
            )
        end
    else
        bhopSpeed = 0
    end
end)

