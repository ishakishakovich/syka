local function buildRow(p)
    local r = Instance.new("TextButton", playersScroll)
    r.Size = UDim2.new(1, -4, 0, 22)
    r.BackgroundColor3 = COL_BTN
    r.BorderSizePixel = 0
    r.Text = ""
    r.AutoButtonColor = false
    local rc = Instance.new("UICorner", r); rc.CornerRadius = UDim.new(0, 2)

    local n = Instance.new("TextLabel", r)
    n.Size = UDim2.new(1, -60, 1, 0)
    n.Position = UDim2.new(0, 6, 0, 0)
    n.BackgroundTransparency = 1
    n.Font = MONO
    n.Text = p.DisplayName
    n.TextColor3 = COL_TEXT
    n.TextSize = 10
    n.TextXAlignment = Enum.TextXAlignment.Left
    n.TextTruncate = Enum.TextTruncate.AtEnd

    local info = Instance.new("TextLabel", r)
    info.Size = UDim2.new(0, 40, 1, 0)
    info.Position = UDim2.new(1, -46, 0, 0)
    info.BackgroundTransparency = 1
    info.Font = MONO
    info.Text = "—"
    info.TextColor3 = COL_DIM
    info.TextSize = 9
    info.TextXAlignment = Enum.TextXAlignment.Right

    local function setActive(on)
        if on then
            r.BackgroundColor3 = COL_ACCENT
            n.TextColor3 = COL_BG
            info.TextColor3 = COL_BG
        else
            r.BackgroundColor3 = COL_BTN
            n.TextColor3 = COL_TEXT
            info.TextColor3 = COL_DIM
        end
    end

    r.MouseButton1Click:Connect(function()
        if C.selectedNames[p.Name] then
            C.selectedNames[p.Name] = nil
        else
            C.selectedNames[p.Name] = true
        end
        setActive(C.selectedNames[p.Name] and true or false)
    end)

    listRows[p.Name] = { btn = r, setActive = setActive, info = info }
end

local function refreshList()
    for n, row in pairs(listRows) do
        pcall(function() row.btn:Destroy() end)
        listRows[n] = nil
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= plr then buildRow(p) end
    end
    for n, row in pairs(listRows) do
        if C.selectedNames[n] then row.setActive(true) end
    end
end

