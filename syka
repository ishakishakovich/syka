local listRows = {}

local function buildRow(p)
    local row = Instance.new("TextButton", scroll)
    row.Size = UDim2.new(1, -4, 0, 34)
    row.BackgroundColor3 = COL_BTN
    row.BackgroundTransparency = 1
    row.BorderSizePixel = 0
    row.Text = ""
    row.AutoButtonColor = false
    corner(row, 5)

    local name = Instance.new("TextLabel", row)
    name.Size = UDim2.new(1, -50, 0, 18)
    name.Position = UDim2.new(0, 10, 0, 3)
    name.BackgroundTransparency = 1
    name.Font = Enum.Font.GothamBold
    name.Text = p.Name
    name.TextColor3 = Color3.fromRGB(230, 240, 230)
    name.TextSize = 12
    name.TextXAlignment = Enum.TextXAlignment.Left

    local info = Instance.new("TextLabel", row)
    info.Size = UDim2.new(1, -50, 0, 12)
    info.Position = UDim2.new(0, 10, 0, 19)
    info.BackgroundTransparency = 1
    info.Font = Enum.Font.Gotham
    info.Text = "HP: ?"
    info.TextColor3 = COL_ACCENT2
    info.TextSize = 10
    info.TextXAlignment = Enum.TextXAlignment.Left

    local badge = Instance.new("TextLabel", row)
    badge.Size = UDim2.new(0, 30, 1, 0)
    badge.Position = UDim2.new(1, -34, 0, 0)
    badge.BackgroundTransparency = 1
    badge.Font = Enum.Font.GothamBold
    badge.Text = ""
    badge.TextColor3 = COL_ACCENT
    badge.TextSize = 16
    badge.TextXAlignment = Enum.TextXAlignment.Center

    local function setActive(on)
        if on then
            row.BackgroundTransparency = 0
            row.BackgroundColor3 = COL_ACCENT
            name.TextColor3 = Color3.fromRGB(14, 10, 20)
            info.TextColor3 = Color3.fromRGB(14, 10, 20)
            badge.Text = "✓"
            badge.TextColor3 = Color3.fromRGB(14, 10, 20)
        else
            row.BackgroundTransparency = 1
            name.TextColor3 = Color3.fromRGB(230, 240, 230)
            info.TextColor3 = COL_ACCENT2
            badge.Text = ""
        end
    end

    row.MouseButton1Click:Connect(function()
        if C.selectedNames[p.Name] then
            C.selectedNames[p.Name] = nil
        else
            C.selectedNames[p.Name] = true
        end
        setActive(C.selectedNames[p.Name] and true or false)
    end)

    listRows[p.Name] = { btn = row, setActive = setActive, info = info, player = p }
end

local function refreshList()
    for n, r in pairs(listRows) do
        pcall(function() r.btn:Destroy() end)
        listRows[n] = nil
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= plr then buildRow(p) end
    end
    for n, r in pairs(listRows) do
        if C.selectedNames[n] then r.setActive(true) end
    end
end

refreshList()
Players.PlayerAdded:Connect(function() task.wait(0.5); refreshList() end)
Players.PlayerRemoving:Connect(function(p)
    C.selectedNames[p.Name] = nil
    task.wait(0.3)
    refreshList()
end)

