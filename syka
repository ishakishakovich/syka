    check.Text = C[key] and "✓" or ""
    check.TextColor3 = COL_BG
    check.TextSize = 10

    local btn = Instance.new("TextButton", row)
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""

    local function update()
        local on = C[key]
        Tween:Create(box, TweenInfo.new(0.12), {
            BackgroundColor3 = on and COL_ACCENT or COL_BTN,
        }):Play()
        box.UIStroke.Color = on and COL_ACCENT or COL_OFF
        check.Text = on and "✓" or ""
    end

    btn.MouseButton1Click:Connect(function()
