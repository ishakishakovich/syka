-- MAIN HEARTBEAT — оптимизирован
RS.Heartbeat:Connect(function(dt)
    heartbeatFrame = heartbeatFrame + 1

    local hrp, hum = getMyChar()
    if not hrp or not hum then return end

    -- no slowdown
    if C.noSlowdownEnabled and hum.Health > 0 and hum.WalkSpeed < C.noSlowdownSpeed then
        hum.WalkSpeed = C.noSlowdownSpeed
    end

    -- fast stop — проверка раз в 3 кадра + debounce на запись
    if C.fastStop and hum.Health > 0 and heartbeatFrame % 3 == 0 then
        if tick() - lastFastStopWrite > 0.1 then
            local v = hrp.AssemblyLinearVelocity
            local speed = math.sqrt(v.X * v.X + v.Z * v.Z)
            if speed > 5 and hum.MoveDirection.Magnitude < 0.01 then
                local st = hum:GetState()
                if st == Enum.HumanoidStateType.Running or st == Enum.HumanoidStateType.Landed then
                    hrp.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
                    lastFastStopWrite = tick()
                end
            end
        end
    end

    -- fly
    if C.flyEnabled and hum.Health > 0 then
        local tgt = getFlyVec()
        flyVel = flyVel:Lerp(tgt, math.min(dt * C.flySmooth, 1))
        hrp.AssemblyLinearVelocity = flyVel
    end

    -- lock
    locked = isLockDown()
    local count = 0
    for _ in pairs(C.selectedNames) do count = count + 1 end

    if not locked or count == 0 then
        sLbl.Text = (count > 0) and ("IDLE // " .. count .. " TRG") or "IDLE"
        sLbl.TextColor3 = Color3.fromRGB(100, 100, 110)
        sStroke.Color = Color3.fromRGB(240, 70, 80)
        dot.Visible = false
        cachedPart = nil
        return
    end

    if tick() - lastRefresh > 0.2 then
        lastRefresh = tick()
        cachedPart, cachedPlr = findTarget()
    end

    if not cachedPart or not cachedPlr then
        sLbl.Text = "LOCK // NO TRG"
        sLbl.TextColor3 = Color3.fromRGB(240, 70, 80)
        sStroke.Color = Color3.fromRGB(240, 70, 80)
        dot.Visible = false
        return
    end

    sLbl.Text = "LOCK // " .. cachedPlr.DisplayName
    sLbl.TextColor3 = Color3.fromRGB(80, 200, 120)
    sStroke.Color = Color3.fromRGB(80, 200, 120)
    sStroke.Transparency = 0.2

    if C.showDot then
        local sp, onScreen = cam:WorldToViewportPoint(cachedPart.Position)
        if onScreen then
            dot.Visible = true
            dot.Position = UDim2.new(0, sp.X, 0, sp.Y)
        else
            dot.Visible = false
        end
    end
end)

RS.RenderStepped:Connect(function(dt)
    if not locked or not cachedPart then return end
    local desired = CFrame.lookAt(cam.CFrame.Position, cachedPart.Position)
    local a = math.clamp(dt * 60 * (1 / math.max(C.smooth, 0.01)), 0, 1)
    cam.CFrame = cam.CFrame:Lerp(desired, a)
end)

