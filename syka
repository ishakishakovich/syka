local hitmarkerTween = nil
local function showHitmarker()
    if not C.hitmarkerEnabled then return end
    hitmarkerGui.Visible = true
    hitmarkerGui.Size = UDim2.new(0, 60, 0, 60)
    for _, l in ipairs(hitLines) do
        l.BackgroundColor3 = C.hitmarkerColor
        l.Size = UDim2.new(0, 2, 0, 12)
    end
    if hitmarkerTween then hitmarkerTween:Cancel() end
    hitmarkerTween = Tween:Create(hitmarkerGui, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 90, 0, 90),
    })
    hitmarkerTween:Play()
    for _, l in ipairs(hitLines) do
        Tween:Create(l, TweenInfo.new(0.35), {
            BackgroundTransparency = 1,
        }):Play()
    end
    task.delay(0.35, function()
        if hitmarkerGui then
            hitmarkerGui.Visible = false
            for _, l in ipairs(hitLines) do
                l.BackgroundTransparency = 0
            end
        end
    end)
end

