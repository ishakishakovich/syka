-- CONFIG
-- ============================================================
local C = {
    enabled       = true,
    key           = Enum.KeyCode.E,
    mode          = "hold",
    smooth        = 0.2,
    targetPart    = "Head",
    teamCheck     = true,
    ignoreDead    = true,
    showHighlight = true,
    showDot       = true,
    showArrow     = true,       -- стрелка на экране к цели
    showDistance  = true,       -- дистанция до цели
    showHud       = true,
    selectedName  = nil,        -- выбранный игрок
}

local COL_ACCENT  = Color3.fromRGB(120, 230, 100)
local COL_ACCENT2 = Color3.fromRGB(80, 180, 70)
local COL_DANGER  = Color3.fromRGB(255, 90, 100)
local COL_OFF     = Color3.fromRGB(40, 60, 40)

-- ============================================================
-- STATE
-- ============================================================
local locked = false
local targetPart = nil
local targetPlr = nil
local highlight = nil

-- ============================================================
-- HELPERS
-- ============================================================
local function getChar() return plr.Character end

local function getTargetPart(char)
    if not char then return nil end
    return char:FindFirstChild(C.targetPart)
        or char:FindFirstChild("Head")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("HumanoidRootPart")
end

local function valid(p)
    if p == plr then return false end
    if C.teamCheck and plr.Team and p.Team == plr.Team then return false end
    local c = p.Character
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h then return false end
    if C.ignoreDead and h.Health <= 0 then return false end
    return true
end

local function getSelectedPlayer()
    if not C.selectedName then return nil end
    return Players:FindFirstChild(C.selectedName)
end

local function findTarget()
    local p = getSelectedPlayer()
    if p and valid(p) then
        local part = getTargetPart(p.Character)
        if part then
            targetPlr = p
            return part
        end
    end
    targetPlr = nil
    return nil
end

local function clearHighlight()
    if highlight then
        pcall(function() highlight:Destroy() end)
        highlight = nil
    end
end

local function applyHighlight()
    clearHighlight()
    if not C.showHighlight then return end
    if not targetPlr or not targetPlr.Character then return end
    local h = Instance.new("Highlight")
    h.Adornee = targetPlr.Character
    h.FillColor = COL_ACCENT
    h.OutlineColor = COL_ACCENT
    h.FillTransparency = 0.7
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = targetPlr.Character
    highlight = h
end

