-- ============================================================
-- MAIN LOOP
-- ============================================================
RS.RenderStepped:Connect(function(dt)
    if not C.enabled then return end

    if not locked then
        if C.showHud then
            statusLbl.Text = C.selectedName and ("TARGET: " .. C.selectedName .. "  (locked off)") or "LOCK OFF  •  no target chosen"
            statusLbl.TextColor3 = Color3.fromRGB(180, 180, 190)
            statusStroke.Color = COL_DANGER
            statusStroke.Transparency = 0.6
        end
        dot.Visible = false
        arrow.Visible = false
        distLbl.Text = ""
        clearHighlight()
        return
    end

    -- найти цель
    if not targetPart or not targetPart.Parent or not targetPlr or not targetPlr.Character then
        targetPart = findTarget()
        if targetPart then
            applyHighlight()
        else
            if C.showHud then
                statusLbl.Text = "LOCK ON  •  no target"
                statusLbl.TextColor3 = Color3.fromRGB(255, 200, 80)
                statusStroke.Color = Color3.fromRGB(255, 200, 80)
            end
            dot.Visible = false
            arrow.Visible = false
            distLbl.Text = ""
            clearHighlight()
            return
        end
    end

    -- HUD
    if C.showHud then
        statusLbl.Text = "LOCK ON  •  " .. (targetPlr and targetPlr.Name or "?")
        statusLbl.TextColor3 = COL_ACCENT
        statusStroke.Color = COL_ACCENT
        statusStroke.Transparency = 0.2
    end

    if not targetPart then return end
    if not cam then return end

    -- позиция на экране
    local sp, onScreen = cam:WorldToViewportPoint(targetPart.Position)
    local camPos = cam.CFrame.Position
    local worldDist = (targetPart.Position - camPos).Magnitude

    -- dot
    if C.showDot and onScreen then
        dot.Visible = true
        dot.Position = UDim2.new(0, sp.X, 0, sp.Y)
    else
        dot.Visible = false
    end

    -- distance
    if C.showDistance and C.showHud then
        distLbl.Text = string.format("%d studs", math.floor(worldDist))
    else
        distLbl.Text = ""
    end

    -- arrow (когда цель за экраном)
    if C.showArrow and not onScreen then
        arrow.Visible = true
        local viewportSize = cam.ViewportSize
        local screenCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
        local dir = Vector2.new(sp.X - screenCenter.X, sp.Y - screenCenter.Y)
        if dir.Magnitude < 0.01 then
            dir = Vector2.new(0, 1)
        end
        dir = dir.Unit
        -- угол поворота
        local angle = math.deg(math.atan2(dir.Y, dir.X))
        arrow.Rotation = angle + 90
        -- позиция по краю экрана (радиус от центра)
        local radius = math.min(viewportSize.X, viewportSize.Y) * 0.35
        local arrowPos = screenCenter + dir * radius
        arrow.Position = UDim2.new(0, arrowPos.X, 0, arrowPos.Y)
    else
        arrow.Visible = false
    end

    -- камера
    local desired = CFrame.lookAt(camPos, targetPart.Position)
    local a = math.clamp(dt * 60 * (1 / math.max(C.smooth, 0.01)), 0, 1)
    cam.CFrame = cam.CFrame:Lerp(desired, a)
end)

