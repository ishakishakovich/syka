-- ===== AIM / ESP LOGIC =====
local function isEnemy(p)
    if p == LP then return false end
    if Cfg.Enemies[p.Name] then return true end
    if Cfg.ESPTeamCheck and LP.Team and p.Team == LP.Team then return false end
    return true
end
local function getPart(ch, name)
    return ch:FindFirstChild(name) or ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")
end
local function validTarget(p)
    if p == LP then return false end
    local ch = p.Character; if not ch then return false end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return true, ch
end
local function closestTo(fov, partName, point)
    local best, bestD = nil, fov
    for _, p in ipairs(Players:GetPlayers()) do
        local ok, ch = validTarget(p)
        if ok and isEnemy(p) then
            local part = getPart(ch, partName)
            if part then
                local sp, on = cam:WorldToViewportPoint(part.Position)
                if on then
                    local d = (Vector2.new(sp.X, sp.Y) - point).Magnitude
                    if d < bestD then bestD, best = d, part end
                end
            end
        end
    end
    return best
end

-- Silent aim: hook namecall
local silentTarget = nil
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if not Cfg.SilentAim or not silentTarget then return oldNamecall(self, ...) end
    local args = {...}
    if method == "Raycast" and self == workspace then
        local o, d = args[1], args[2]
        if typeof(o) == "Vector3" and typeof(d) == "Vector3" then
            args[2] = (silentTarget.Position - o).Unit * d.Magnitude
            return oldNamecall(self, unpack(args))
        end
    elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" then
        local r = args[1]
        if typeof(r) == "Ray" then
            args[1] = Ray.new(r.Origin, (silentTarget.Position - r.Origin).Unit * 5000)
            return oldNamecall(self, unpack(args))
        end
    elseif method == "ScreenPointToRay" and self == cam then
        local r = oldNamecall(self, ...)
        if typeof(r) == "Ray" then
            return Ray.new(r.Origin, (silentTarget.Position - r.Origin).Unit * 5000)
        end
    end
    return oldNamecall(self, ...)
end))

-- Silent aim: hook Mouse.Hit / Mouse.UnitRay (Arsenal uses this heavily)
local realMouse = LP:GetMouse()
local oldIndex
oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
    if Cfg.SilentAim and silentTarget and rawequal(self, realMouse) then
        if key == "Hit" then
            return CFrame.new(silentTarget.Position)
        elseif key == "UnitRay" then
            local o = cam.CFrame.Position
            return Ray.new(o, (silentTarget.Position - o).Unit * 5000)
        end
    end
    return oldIndex(self, key)
end))

-- Main aim loop
RS.RenderStepped:Connect(function()
    local mouse = UIS:GetMouseLocation()
    if Cfg.SilentAim and UIS:IsKeyDown(Cfg.SilentAimKey) then
        silentTarget = closestTo(Cfg.SilentAimFOV, Cfg.SilentAimPart, mouse)
    else
        silentTarget = nil
    end
    if Cfg.Aimbot and UIS:IsKeyDown(Cfg.AimbotKey) then
        local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
        local t = closestTo(Cfg.AimbotFOV, Cfg.AimbotPart, center)
        if t then
            local goal = CFrame.new(cam.CFrame.Position, t.Position)
            local sm = math.clamp(Cfg.AimbotSmooth, 0, 0.95)
            cam.CFrame = cam.CFrame:Lerp(goal, 1 - sm)
        end
    end
end)

-- ESP
local drawings = {}
local function createESP(p)
    if drawings[p] or not Drawing then return end
    local d = {
        box = Drawing.new("Square"),
        name = Drawing.new("Text"),
        dist = Drawing.new("Text"),
        hp = Drawing.new("Square"),
        tracer = Drawing.new("Line"),
    }
    d.box.Thickness = 1; d.box.Filled = false
    d.name.Size = 16; d.name.Center = true; d.name.Outline = true
    d.dist.Size = 14; d.dist.Center = true; d.dist.Outline = true
    d.dist.Color = Color3.fromRGB(200,200,200)
    d.hp.Filled = true; d.hp.Thickness = 1
    d.tracer.Thickness = 1
    drawings[p] = d
end
local function destroyESP(p)
    local d = drawings[p]; if not d then return end
    for _, o in pairs(d) do pcall(function() o:Remove() end) end
    drawings[p] = nil
end

RS.RenderStepped:Connect(function()
    if not Drawing then return end
    if not Cfg.ESP then
        for p in pairs(drawings) do destroyESP(p) end
        return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then destroyESP(p) continue end
        local ok, ch = validTarget(p)
        if not ok then destroyESP(p) continue end
        local root = ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Head")
        if not root then destroyESP(p) continue end
        createESP(p)
        local d = drawings[p]; if not d then continue end
        local sp, on = cam:WorldToViewportPoint(root.Position)
        if not on then
            for _, o in pairs(d) do o.Visible = false end
            continue
        end
        local hum = ch:FindFirstChildOfClass("Humanoid")
        local col = isEnemy(p) and Color3.fromRGB(255,60,60) or Color3.fromRGB(60,255,60)
        local h, w = 60, 40
        local tl = Vector2.new(sp.X - w/2, sp.Y - h/2)
        local dist = (cam.CFrame.Position - root.Position).Magnitude

        d.box.Visible = Cfg.ESPBox
        if Cfg.ESPBox then d.box.Size = Vector2.new(w,h); d.box.Position = tl; d.box.Color = col end
        d.name.Visible = Cfg.ESPName
        if Cfg.ESPName then
            d.name.Text = p.Name
            d.name.Position = Vector2.new(sp.X, sp.Y - h/2 - 20)
            d.name.Color = col
        end
        d.dist.Visible = Cfg.ESPDistance
        if Cfg.ESPDistance then
            d.dist.Text = "["..math.floor(dist).."]"
            d.dist.Position = Vector2.new(sp.X, sp.Y + h/2 + 4)
        end
        d.hp.Visible = Cfg.ESPHealth
        if Cfg.ESPHealth and hum then
            local pct = hum.Health / math.max(hum.MaxHealth, 1)
            d.hp.Size = Vector2.new(4, h*pct)
            d.hp.Position = Vector2.new(tl.X - 8, tl.Y + h*(1-pct))
            d.hp.Color = Color3.fromRGB(255*(1-pct), 255*pct, 0)
        end
        d.tracer.Visible = Cfg.ESPTracer
        if Cfg.ESPTracer then
            d.tracer.From = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y)
            d.tracer.To = Vector2.new(sp.X, sp.Y)
            d.tracer.Color = col
        end
    end
end)
