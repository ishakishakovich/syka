-- ============================================================
-- HELPERS
-- ============================================================
local function getTargetPart(char)
    if not char then return nil end
    return char:FindFirstChild(C.targetPart)
        or char:FindFirstChild("Head")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("HumanoidRootPart")
end

local function getArmor(p)
    if not p then return nil end
    local names = {"Armor","armor","ArmorVal","ArmorPoints","Shield","shield","Armour","armour"}
    local containers = {p, p.Character, p:FindFirstChild("leaderstats"), p:FindFirstChild("Stats")}
    for _, cont in ipairs(containers) do
        if cont then
            for _, n in ipairs(names) do
                local inst = cont:FindFirstChild(n)
                if inst and (inst:IsA("NumberValue") or inst:IsA("IntValue")) then
                    return inst.Value
                end
            end
        end
    end
    return nil
end

local function valid(p)
    if not p then return false end
    if p == plr then return false end
    if C.teamCheck and plr.Team and p.Team == plr.Team then return false end
    local c = p.Character
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h then return false end
    if C.ignoreDead and h.Health <= 0 then return false end
    return true
end

local function isLockKeyDown()
    if UIS:GetFocusedTextBox() then return false end
    if C.lockButton == "E" then return UIS:IsKeyDown(Enum.KeyCode.E)
    elseif C.lockButton == "RMB" then return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    elseif C.lockButton == "Q" then return UIS:IsKeyDown(Enum.KeyCode.Q) end
    return false
end

local function countSelected()
    local n = 0
    for _ in pairs(C.selectedNames) do n = n + 1 end
    return n
end

local function findNearestTarget()
    local camPos = cam.CFrame.Position
    local bestPart, bestPlr, bestDist = nil, nil, math.huge
    for name, _ in pairs(C.selectedNames) do
        local p = Players:FindFirstChild(name)
        if p and valid(p) then
            local part = getTargetPart(p.Character)
            if part then
                local d = (part.Position - camPos).Magnitude
                if d < bestDist then
                    bestDist = d
                    bestPart = part
                    bestPlr = p
                end
            end
        end
    end
    return bestPart, bestPlr, bestDist
end

-- ============================================================
-- NO SLOWDOWN
-- ============================================================
local function startNoSlowdown()
    if noSlowdownConn then return end
    noSlowdownConn = RS.RenderStepped:Connect(function()
        if not C.noSlowdownEnabled then return end
        local char = plr.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        if hum.WalkSpeed < C.noSlowdownSpeed then
            hum.WalkSpeed = C.noSlowdownSpeed
        end
    end)
end

local function stopNoSlowdown()
    if noSlowdownConn then
        noSlowdownConn:Disconnect()
        noSlowdownConn = nil
    end
end

