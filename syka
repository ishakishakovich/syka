    lbl.TextSize = 14; lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Parent = btn
    local keyLbl = Instance.new("TextLabel")
    keyLbl.Size = UDim2.new(0, 90, 0, 24); keyLbl.Position = UDim2.new(1, -100, 0.5, -12)
    keyLbl.BackgroundColor3 = Color3.fromRGB(52, 52, 62)
    keyLbl.Text = currentKey.Name; keyLbl.TextColor3 = Color3.fromRGB(255, 70, 70)
    keyLbl.Font = Enum.Font.GothamBold; keyLbl.TextSize = 12; keyLbl.Parent = btn
    Instance.new("UICorner", keyLbl).CornerRadius = UDim.new(0, 4)
    local waiting = false
    btn.MouseButton1Click:Connect(function()
        if waiting then return end
        waiting = true; keyLbl.Text = "нажми..."
        local conn
        conn = UIS.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                keyLbl.Text = input.KeyCode.Name
                if cb then cb(input.KeyCode) end
                waiting = false; conn:Disconnect()
            end
        end)
    end)
end

