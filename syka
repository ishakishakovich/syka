        Tween:Create(track, TweenInfo.new(0.16), {BackgroundColor3 = on and COL_ACCENT or COL_OFF}):Play()
        Tween:Create(knob, TweenInfo.new(0.16), {Position = on and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)}):Play()
    end
    btn.MouseButton1Click:Connect(function()
        C[key] = not C[key]
        update()
        if onChange then pcall(onChange, C[key]) end
    end)
    return row
end

