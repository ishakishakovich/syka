local _char, _hrp, _hum
local function getMyChar()
    local c = plr.Character
    if c ~= _char then
        _char = c
        _hrp = c and c:FindFirstChild("HumanoidRootPart")
        _hum = c and c:FindFirstChildOfClass("Humanoid")
    end
    return _char, _hrp, _hum
end

local function getTargetPart(char)
    if not char then return nil end
    return char:FindFirstChild(C.targetPart)
        or char:FindFirstChild("Head")
        or char:FindFirstChild("HumanoidRootPart")
end

local function getArmor(p)
    if not p then return nil end
    local names = {"Armor","armor","ArmorVal","Shield","shield","Armour"}
    local conts = {p, p.Character, p:FindFirstChild("leaderstats")}
    for _, c in ipairs(conts) do
        if c then
            for _, n in ipairs(names) do
                local v = c:FindFirstChild(n)
                if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then
                    return v.Value
                end
            end
        end
    end
    return nil
end

local function valid(p)
    if not p or p == plr then return false end
    if C.teamCheck and plr.Team and p.Team == plr.Team then return false end
    local c = p.Character
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h then return false end
    if C.ignoreDead and h.Health <= 0 then return false end
    return true
end

local function isLockKeyDown()
    if UIS:GetFocusedTextBox() then return false end
    if C.lockButton == "E" then return UIS:IsKeyDown(Enum.KeyCode.E)
    elseif C.lockButton == "RMB" then return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    elseif C.lockButton == "Q" then return UIS:IsKeyDown(Enum.KeyCode.Q) end
    return false
end

local function countSelected()
    local n = 0
    for _ in pairs(C.selectedNames) do n = n + 1 end
    return n
end

local function findNearest()
    local camPos = cam.CFrame.Position
    local bestPart, bestPlr, bestDist = nil, nil, math.huge
    for name, _ in pairs(C.selectedNames) do
        local p = Players:FindFirstChild(name)
        if p and valid(p) then
            local part = getTargetPart(p.Character)
            if part then
                local d = (part.Position - camPos).Magnitude
                if d < bestDist then
                    bestDist = d
                    bestPart = part
                    bestPlr = p
                end
            end
        end
    end
    return bestPart, bestPlr, bestDist
end

local function playHitSound()
    if not C.hitSoundEnabled or not C.hitSoundId or C.hitSoundId == "" then return end
    pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = C.hitSoundId
        s.Volume = C.hitSoundVolume
        SoundService:PlayLocalSound(s)
        task.delay(2, function() if s then s:Destroy() end end)
    end)
end

local function updateHighlights()
    if not C.showHighlight then
        for n, h in pairs(highlights) do
            pcall(function() h:Destroy() end)
            highlights[n] = nil
        end
        return
    end
    for name, _ in pairs(C.selectedNames) do
        local p = Players:FindFirstChild(name)
        local should = p and valid(p) and p.Character
        local h = highlights[name]
        if should and not h then
            local n = Instance.new("Highlight")
            n.Adornee = p.Character
            n.FillColor = COL_ACCENT
            n.OutlineColor = COL_ACCENT
            n.FillTransparency = 0.78
            n.OutlineTransparency = 0
            n.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            n.Parent = p.Character
            highlights[name] = n
        elseif not should and h then
            pcall(function() h:Destroy() end)
            highlights[name] = nil
        end
    end
    for name, h in pairs(highlights) do
        if not C.selectedNames[name] then
            pcall(function() h:Destroy() end)
            highlights[name] = nil
        end
    end
end

local function clearHighlights()
    for n, h in pairs(highlights) do
        pcall(function() h:Destroy() end)
        highlights[n] = nil
    end
end

