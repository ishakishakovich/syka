local function toggle(name, def, cb)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 34); btn.BackgroundColor3 = Color3.fromRGB(34, 34, 42)
    btn.Text = ""; btn.AutoButtonColor = false; btn.BorderSizePixel = 0; btn.Parent = Scroll
