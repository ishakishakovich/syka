-- ============================================================
-- MAIN LOOP
-- ============================================================
RS.RenderStepped:Connect(function(dt)
    if not C.enabled then return end

    -- FOV: держим постоянным
    if cam and cam.FieldOfView ~= C.fov then
        cam.FieldOfView = C.fov
    end

    local char = plr.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    -- FLY
    if flyActive and hrp and hum and hum.Health > 0 then
        local target = getFlyTarget()
        flyVel = flyVel:Lerp(target, math.min(dt * C.flySmooth, 1))
        hrp.AssemblyLinearVelocity = flyVel
        if hrp.AssemblyLinearVelocity.Magnitude < 0.1 and target.Magnitude < 0.1 then
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
    end

    -- LOCK
    if C.mode == "hold" then
        locked = isLockKeyDown()
    end

    local count = countSelected()

    if not locked then
        if C.showHud then
            statusLbl.Text = (count > 0) and ("TARGETS: " .. count .. "  (locked off)") or "LOCK OFF"
            statusLbl.TextColor3 = Color3.fromRGB(180, 180, 190)
            statusStroke.Color = COL_DANGER
            statusStroke.Transparency = 0.6
        end
        dot.Visible = false
        arrow.Visible = false
        distLbl.Text = ""
        return
    end

    if count == 0 then
        if C.showHud then
            statusLbl.Text = "LOCK ON  •  no targets"
            statusLbl.TextColor3 = Color3.fromRGB(255, 200, 80)
            statusStroke.Color = Color3.fromRGB(255, 200, 80)
        end
        dot.Visible = false
        arrow.Visible = false
        distLbl.Text = ""
        return
    end

    local part, tplr, dist = findNearestTarget()

    if not part then
        if C.showHud then
            statusLbl.Text = "LOCK ON  •  " .. count .. " targets (none alive)"
            statusLbl.TextColor3 = Color3.fromRGB(255, 200, 80)
            statusStroke.Color = Color3.fromRGB(255, 200, 80)
        end
        dot.Visible = false
        arrow.Visible = false
        distLbl.Text = ""
        return
    end

    if C.showHud then
        statusLbl.Text = "LOCK ON  •  " .. tplr.Name .. "  (" .. count .. " targets)"
        statusLbl.TextColor3 = COL_ACCENT
        statusStroke.Color = COL_ACCENT
        statusStroke.Transparency = 0.2
    end

    if not cam then return end

    local sp, onScreen = cam:WorldToViewportPoint(part.Position)

    if C.showDot and onScreen then
        dot.Visible = true
        dot.Position = UDim2.new(0, sp.X, 0, sp.Y)
    else
        dot.Visible = false
    end

    if C.showDistance and C.showHud then
        distLbl.Text = string.format("%d studs", math.floor(dist))
    else
        distLbl.Text = ""
    end

    if C.showArrow and not onScreen then
        arrow.Visible = true
        local vp = cam.ViewportSize
        local sc = Vector2.new(vp.X / 2, vp.Y / 2)
        local dir = Vector2.new(sp.X - sc.X, sp.Y - sc.Y)
        if dir.Magnitude < 0.01 then dir = Vector2.new(0, 1) end
        dir = dir.Unit
        arrow.Rotation = math.deg(math.atan2(dir.Y, dir.X)) + 90
        local r = math.min(vp.X, vp.Y) * 0.35
        local ap = sc + dir * r
        arrow.Position = UDim2.new(0, ap.X, 0, ap.Y)
    else
        arrow.Visible = false
    end

    local desired = CFrame.lookAt(cam.CFrame.Position, part.Position)
    local a = math.clamp(dt * 60 * (1 / math.max(C.smooth, 0.01)), 0, 1)
    cam.CFrame = cam.CFrame:Lerp(desired, a)
end)

