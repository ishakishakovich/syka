-- MENU OPEN / CLOSE
-- ============================================================
local menuOpen = false

local function openMenu()
    menuOpen = true
    menu.Visible = true
    glow.Visible = true
    menu.Size = UDim2.new(0, MW, 0, 0)
    Tween:Create(menu, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, MW, 0, MH),
    }):Play()
    UIS.MouseBehavior = Enum.MouseBehavior.Default
    UIS.MouseIconEnabled = true
end

local function closeMenu()
    menuOpen = false
    glow.Visible = false
    Tween:Create(menu, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, MW, 0, 0),
    }):Play()
    task.delay(0.18, function()
        if not menuOpen then menu.Visible = false end
    end)
    UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
end

RS:BindToRenderStep("DaHoodMenuUnlock", Enum.RenderPriority.Camera.Value + 1, function()
    if menuOpen then
        if UIS.MouseBehavior ~= Enum.MouseBehavior.Default then
            UIS.MouseBehavior = Enum.MouseBehavior.Default
        end
        if not UIS.MouseIconEnabled then UIS.MouseIconEnabled = true end
    end
end)

closeBtn.MouseButton1Click:Connect(closeMenu)

do
    local dragging, dragStart, startPos
    headerBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = menu.Position
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local d = input.Position - dragStart
            menu.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
end

UIS.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.KeyCode == Enum.KeyCode.RightShift then
        if menuOpen then closeMenu() else openMenu() end
    elseif i.KeyCode == Enum.KeyCode.End then
        pcall(function() gui:Destroy() end)
        pcall(function() hud:Destroy() end)
        clearAllHighlights()
    end
end)

