        bs.Color = C[key] and COL_ACCENT or COL_OFF
        chk.Text = C[key] and "✓" or ""
        if onChange then pcall(onChange, C[key]) end
    end)
end

local function makeSlider(parent, label, key, min, max, suffix)
    local r = Instance.new("Frame", parent)
    r.Size = UDim2.new(1, 0, 0, 30)
    r.BackgroundTransparency = 1
    local top = Instance.new("Frame", r)
    top.Size = UDim2.new(1, 0, 0, 14)
    top.BackgroundTransparency = 1
    local l = Instance.new("TextLabel", top)
    l.Size = UDim2.new(0.7, 0, 1, 0)
    l.BackgroundTransparency = 1
    l.Font = MONO
    l.Text = label
    l.TextColor3 = COL_TEXT
    l.TextSize = 10
    l.TextXAlignment = Enum.TextXAlignment.Left
    local v = Instance.new("TextLabel", top)
    v.Size = UDim2.new(0.3, 0, 1, 0)
    v.Position = UDim2.new(0.7, 0, 0, 0)
    v.BackgroundTransparency = 1
    v.Font = MONO_B
    v.Text = tostring(C[key]) .. (suffix or "")
    v.TextColor3 = COL_ACCENT
    v.TextSize = 10
    v.TextXAlignment = Enum.TextXAlignment.Right

    local bar = Instance.new("Frame", r)
    bar.Size = UDim2.new(1, 0, 0, 3)
    bar.Position = UDim2.new(0, 0, 0, 18)
    bar.BackgroundColor3 = COL_OFF
    bar.BorderSizePixel = 0
    local fill = Instance.new("Frame", bar)
    fill.Size = UDim2.new((C[key] - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = COL_ACCENT
    fill.BorderSizePixel = 0

    local b = Instance.new("TextButton", r)
    b.Size = UDim2.new(1, 0, 0, 12)
    b.Position = UDim2.new(0, 0, 0, 14)
    b.BackgroundTransparency = 1
    b.Text = ""
    local drag = false
    local function setX(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local val = min + (max - min) * rel
        val = math.floor(val * 100 + 0.5) / 100
        C[key] = val
        v.Text = tostring(val) .. (suffix or "")
        fill.Size = UDim2.new(rel, 0, 1, 0)
    end
    b.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = true; setX(i.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if drag and i.UserInputType == Enum.UserInputType.MouseMovement then
            setX(i.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
    end)
end

local function makeBtnRow(parent, items)
    local r = Instance.new("Frame", parent)
    r.Size = UDim2.new(1, 0, 0, 20)
    r.BackgroundTransparency = 1
    local btns = {}
    local w = (1 / #items) - 0.01
    for i, it in ipairs(items) do
        local b = Instance.new("TextButton", r)
        b.Size = UDim2.new(w - 0.006, 0, 1, 0)
        b.Position = UDim2.new((i-1) * w, 0, 0, 0)
        b.BackgroundColor3 = COL_BTN
        b.BorderSizePixel = 0
        b.Font = MONO_B
        b.Text = it[1]
        b.TextColor3 = COL_DIM
        b.TextSize = 10
        b.AutoButtonColor = false
        local bc = Instance.new("UICorner", b); bc.CornerRadius = UDim.new(0, 2)
        table.insert(btns, b)
        b.MouseButton1Click:Connect(function()
            for _, o in ipairs(btns) do
                o.BackgroundColor3 = COL_BTN
                o.TextColor3 = COL_DIM
            end
            b.BackgroundColor3 = COL_ACCENT
            b.TextColor3 = COL_BG
            pcall(it[3])
        end)
    end
    if btns[1] then
        btns[1].BackgroundColor3 = COL_ACCENT
        btns[1].TextColor3 = COL_BG
    end
end

