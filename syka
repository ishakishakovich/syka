local function makeSlider(parent, label, key, min, max, suffix, onChange)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, 0, 0, 34)
    row.BackgroundTransparency = 1
    local top = Instance.new("Frame", row)
    top.Size = UDim2.new(1, 0, 0, 16)
    top.BackgroundTransparency = 1
    local lbl = Instance.new("TextLabel", top)
    lbl.Size = UDim2.new(0.7, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font = MONO
    lbl.Text = label
    lbl.TextColor3 = COL_TEXT
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    local val = Instance.new("TextLabel", top)
    val.Size = UDim2.new(0.3, 0, 1, 0)
    val.Position = UDim2.new(0.7, 0, 0, 0)
    val.BackgroundTransparency = 1
    val.Font = MONO_B
    val.Text = tostring(C[key]) .. (suffix or "")
    val.TextColor3 = COL_ACCENT
    val.TextSize = 10
    val.TextXAlignment = Enum.TextXAlignment.Right
    local bar = Instance.new("Frame", row)
    bar.Size = UDim2.new(1, 0, 0, 3)
    bar.Position = UDim2.new(0, 0, 0, 22)
    bar.BackgroundColor3 = COL_OFF
    bar.BorderSizePixel = 0
    local fill = Instance.new("Frame", bar)
    fill.Size = UDim2.new((C[key] - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = COL_ACCENT
    fill.BorderSizePixel = 0
    local btn = Instance.new("TextButton", row)
    btn.Size = UDim2.new(1, 0, 0, 14)
    btn.Position = UDim2.new(0, 0, 0, 16)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    local dragging = false
    local function setFromX(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local v = min + (max - min) * rel
        v = math.floor(v * 100 + 0.5) / 100
        C[key] = v
        val.Text = tostring(v) .. (suffix or "")
        fill.Size = UDim2.new(rel, 0, 1, 0)
        if onChange then pcall(onChange, v) end
    end
    btn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; setFromX(i.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            setFromX(i.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    return row
end

local function makeBtnRow(parent, items)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, 0, 0, 22)
    row.BackgroundTransparency = 1
    local btns = {}
    local count = #items
    local w = (1 / count) - 0.01
    for i, item in ipairs(items) do
        local b = Instance.new("TextButton", row)
        b.Size = UDim2.new(w - 0.006, 0, 1, 0)
        b.Position = UDim2.new((i-1) * w, 0, 0, 0)
        b.BackgroundColor3 = COL_BTN
        b.BorderSizePixel = 0
        b.Font = MONO_B
        b.Text = item[1]
        b.TextColor3 = COL_DIM
        b.TextSize = 10
        b.AutoButtonColor = false
        corner(b, 2)
        stroke(b, COL_OFF, 1, 0.3)
        table.insert(btns, b)
        b.MouseButton1Click:Connect(function()
            for _, other in ipairs(btns) do
                other.BackgroundColor3 = COL_BTN
                other.TextColor3 = COL_DIM
            end
            b.BackgroundColor3 = COL_ACCENT
            b.TextColor3 = COL_BG
            pcall(item[3])
        end)
    end
    if btns[1] then
        btns[1].BackgroundColor3 = COL_ACCENT
        btns[1].TextColor3 = COL_BG
    end
    return row
end

local function makeButton(parent, label, callback, color)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1, 0, 0, 22)
    btn.BackgroundColor3 = COL_BTN
    btn.BorderSizePixel = 0
    btn.Font = MONO_B
    btn.Text = label
    btn.TextColor3 = color or COL_TEXT
    btn.TextSize = 10
    btn.AutoButtonColor = false
    corner(btn, 2)
    stroke(btn, COL_OFF, 1, 0.3)
    btn.MouseEnter:Connect(function()
        Tween:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = COL_ACCENT}):Play()
        btn.TextColor3 = COL_BG
    end)
    btn.MouseLeave:Connect(function()
        Tween:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = COL_BTN}):Play()
        btn.TextColor3 = color or COL_TEXT
    end)
    btn.MouseButton1Click:Connect(function()
        local ok, err = pcall(callback)
        if not ok then warn("[azraeell] " .. tostring(err)) end
    end)
    return btn
end

