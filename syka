local function playHitSound()
    if not C.hitSoundEnabled then return end
    if not C.hitSoundId or C.hitSoundId == "" then return end
    pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = C.hitSoundId
        s.Volume = C.hitSoundVolume
        s.PlaybackSpeed = 1
        SoundService:PlayLocalSound(s)
        task.delay(3, function()
            if s then s:Destroy() end
        end)
    end)
end

-- ============================================================
-- FLY
-- ============================================================
local function getFlyTarget()
    if UIS:GetFocusedTextBox() then return Vector3.zero end
    local camCF = cam.CFrame
    local move = Vector3.zero
    local fwd = camCF.LookVector
    local right = camCF.RightVector
    if UIS:IsKeyDown(Enum.KeyCode.W) then move = move + fwd end
    if UIS:IsKeyDown(Enum.KeyCode.S) then move = move - fwd end
    if UIS:IsKeyDown(Enum.KeyCode.A) then move = move - right end
    if UIS:IsKeyDown(Enum.KeyCode.D) then move = move + right end
    if UIS:IsKeyDown(Enum.KeyCode.Space) then
        move = move + Vector3.new(0, 1, 0) * (C.flyVertical / C.flySpeed)
    end
    if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
        move = move - Vector3.new(0, 1, 0) * (C.flyVertical / C.flySpeed)
    end
    if move.Magnitude > 0 then move = move.Unit * C.flySpeed end
    return move
end

-- ============================================================
-- HIGHLIGHTS
-- ============================================================
local function updateHighlights()
    for name, h in pairs(highlights) do
        local p = Players:FindFirstChild(name)
        local shouldRemove = true
        if p and C.selectedNames[name] and valid(p) and p.Character then
            if h.Parent == p.Character then shouldRemove = false end
        end
        if shouldRemove then
            pcall(function() h:Destroy() end)
            highlights[name] = nil
        end
    end
    if not C.showHighlight then return end
    for name, _ in pairs(C.selectedNames) do
        local p = Players:FindFirstChild(name)
        if p and valid(p) and p.Character and not highlights[name] then
            local h = Instance.new("Highlight")
            h.Adornee = p.Character
            h.FillColor = COL_ACCENT
            h.OutlineColor = COL_ACCENT
            h.FillTransparency = 0.75
            h.OutlineTransparency = 0
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Parent = p.Character
            highlights[name] = h
        end
    end
end

local function clearAllHighlights()
    for name, h in pairs(highlights) do
        pcall(function() h:Destroy() end)
        highlights[name] = nil
    end
end

-- ============================================================
-- FPS BOOSTER (БЕЗ ЛАГА — один скан + DescendantAdded)
-- ============================================================
local fpsAddConn = nil
local function shouldDisable(d)
    return d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam")
        or d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles")
        or d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight")
end

local function enableFpsBooster()
    if fpsBoosterActive then return end
    fpsBoosterActive = true
    fpsDisabled = {}
    fpsLightingSaved = {
        GlobalShadows = Lighting.GlobalShadows,
        FogEnd = Lighting.FogEnd,
        EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
        EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
    }
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 1e7
    Lighting.EnvironmentDiffuseScale = 0
    Lighting.EnvironmentSpecularScale = 0
    pcall(function()
        UserSettingsService().GameSettings.SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
    end)

    -- ОДИН проход, без цикла
    for _, d in ipairs(workspace:GetDescendants()) do
        if shouldDisable(d) then
            pcall(function()
                if d.Enabled then
                    d.Enabled = false
                    table.insert(fpsDisabled, d)
                end
            end)
        end
    end

    -- ловим новые объекты — дёшево
    if fpsAddConn then fpsAddConn:Disconnect() end
    fpsAddConn = workspace.DescendantAdded:Connect(function(d)
        if not fpsBoosterActive then return end
        if shouldDisable(d) then
            task.defer(function()
                pcall(function()
                    if d.Parent and d.Enabled then
                        d.Enabled = false
                        table.insert(fpsDisabled, d)
                    end
                end)
            end)
        end
    end)
end

local function disableFpsBooster()
    if not fpsBoosterActive then return end
    fpsBoosterActive = false
    if fpsAddConn then fpsAddConn:Disconnect(); fpsAddConn = nil end
    if fpsLightingSaved.GlobalShadows ~= nil then Lighting.GlobalShadows = fpsLightingSaved.GlobalShadows end
    if fpsLightingSaved.FogEnd then Lighting.FogEnd = fpsLightingSaved.FogEnd end
    if fpsLightingSaved.EnvironmentDiffuseScale then Lighting.EnvironmentDiffuseScale = fpsLightingSaved.EnvironmentDiffuseScale end
    if fpsLightingSaved.EnvironmentSpecularScale then Lighting.EnvironmentSpecularScale = fpsLightingSaved.EnvironmentSpecularScale end
    pcall(function()
        UserSettingsService().GameSettings.SavedQualityLevel = Enum.SavedQualitySetting.Automatic
    end)
    for _, d in ipairs(fpsDisabled) do
        pcall(function()
            if d and d.Parent then d.Enabled = true end
        end)
    end
    fpsDisabled = {}
end

