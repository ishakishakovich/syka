    local ind = Instance.new("Frame")
    ind.Size = UDim2.new(0, 40, 0, 18); ind.Position = UDim2.new(1, -50, 0.5, -9)
    ind.BackgroundColor3 = def and Color3.fromRGB(255, 70, 70) or Color3.fromRGB(52, 52, 62)
