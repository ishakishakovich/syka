    local bar = Instance.new("Frame", row)
    bar.Size = UDim2.new(1, 0, 0, 5)
    bar.Position = UDim2.new(0, 0, 0, 26)
    bar.BackgroundColor3 = COL_OFF
    bar.BorderSizePixel = 0
    corner(bar, 3)
    local fill = Instance.new("Frame", bar)
    fill.Size = UDim2.new((C[key] - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = COL_ACCENT
    fill.BorderSizePixel = 0
    corner(fill, 3)
    local btn = Instance.new("TextButton", row)
    btn.Size = UDim2.new(1, 0, 0, 20)
    btn.Position = UDim2.new(0, 0, 0, 18)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    local dragging = false
    local function setFromX(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local v = min + (max - min) * rel
        v = math.floor(v * 100 + 0.5) / 100
        C[key] = v
        val.Text = tostring(v) .. (suffix or "")
        Tween:Create(fill, TweenInfo.new(0.08), {Size = UDim2.new(rel, 0, 1, 0)}):Play()
        if onChange then pcall(onChange, v) end
    end
    btn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; setFromX(i.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            setFromX(i.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    return row
end

local function makeButton(parent, label, callback, color)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1, 0, 0, 28)
    btn.BackgroundColor3 = COL_BTN
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.GothamBold
    btn.Text = label
    btn.TextColor3 = color or COL_TEXT
    btn.TextSize = 11
    btn.AutoButtonColor = false
    corner(btn, 4)
    btn.MouseEnter:Connect(function()
        Tween:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = COL_ACCENT}):Play()
        btn.TextColor3 = COL_BG
    end)
    btn.MouseLeave:Connect(function()
        Tween:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = COL_BTN}):Play()
        btn.TextColor3 = color or COL_TEXT
    end)
    btn.MouseButton1Click:Connect(function()
        local ok, err = pcall(callback)
        if not ok then warn("[LOCK] " .. tostring(err)) end
    end)
    return btn
end

local function makeBtnRow(parent, items)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, 0, 0, 26)
    row.BackgroundTransparency = 1
    local btns = {}
    local count = #items
    local w = (1 / count) - 0.01
    for i, item in ipairs(items) do
        local b = Instance.new("TextButton", row)
        b.Size = UDim2.new(w - 0.008, 0, 1, 0)
        b.Position = UDim2.new((i-1) * w, 0, 0, 0)
        b.BackgroundColor3 = COL_BTN
        b.BorderSizePixel = 0
        b.Font = Enum.Font.GothamBold
        b.Text = item[1]
        b.TextColor3 = COL_DIM
        b.TextSize = 10
        b.AutoButtonColor = false
        corner(b, 4)
        table.insert(btns, b)
        b.MouseButton1Click:Connect(function()
            for _, other in ipairs(btns) do
                other.BackgroundColor3 = COL_BTN
                other.TextColor3 = COL_DIM
            end
            b.BackgroundColor3 = COL_ACCENT
            b.TextColor3 = COL_BG
            pcall(item[3])
        end)
    end
    if btns[1] then
        btns[1].BackgroundColor3 = COL_ACCENT
        btns[1].TextColor3 = COL_BG
    end
    return row, btns
end

