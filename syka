local function getMyChar()
    local c = plr.Character
    if c ~= cachedChar then
        cachedChar = c
        cachedHrp = c and c:FindFirstChild("HumanoidRootPart")
        cachedHum = c and c:FindFirstChildOfClass("Humanoid")
        if c then
            task.defer(function()
                if cachedHum then
                    local animator = cachedHum:FindFirstChildOfClass("Animator")
                    if animator and not currentFlyAnimator then
                        currentFlyAnimator = animator
                    end
                end
            end)
        end
    end
    return cachedHrp, cachedHum
end

local function valid(p)
    if not p or p == plr then return false end
    local c = p.Character
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return false end
    return true
end

local function getPart(char)
    if not char then return nil end
    return char:FindFirstChild(C.targetPart)
        or char:FindFirstChild("Head")
        or char:FindFirstChild("HumanoidRootPart")
end

local function isLockDown()
    if C.lockButton == "E" then return UIS:IsKeyDown(Enum.KeyCode.E) end
    if C.lockButton == "Q" then return UIS:IsKeyDown(Enum.KeyCode.Q) end
    if C.lockButton == "RMB" then return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) end
    return false
end

local function findTarget()
    local cp = cam.CFrame.Position
    local bp, bpl, bd = nil, nil, math.huge
    for name, _ in pairs(C.selectedNames) do
        local p = Players:FindFirstChild(name)
        if p and valid(p) then
            local part = getPart(p.Character)
            if part then
                local d = (part.Position - cp).Magnitude
                if d < bd then bd = d; bp = part; bpl = p end
            end
        end
    end
    return bp, bpl
end

local function updateHl()
    for n, h in pairs(highlights) do
        local p = Players:FindFirstChild(n)
        if not (p and C.selectedNames[n] and valid(p) and p.Character) then
            pcall(function() h:Destroy() end)
            highlights[n] = nil
        end
    end
    if not C.showHighlight then return end
    for n, _ in pairs(C.selectedNames) do
        local p = Players:FindFirstChild(n)
        if p and valid(p) and p.Character and not highlights[n] then
            local h = Instance.new("Highlight")
            h.Adornee = p.Character
            h.FillColor = Color3.fromRGB(230, 70, 80)
            h.OutlineColor = Color3.fromRGB(230, 70, 80)
            h.FillTransparency = 0.78
            h.OutlineTransparency = 0
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Parent = p.Character
            highlights[n] = h
        end
    end
end

local function getFlyVec()
    local ccf = cam.CFrame
    local move = Vector3.zero
    local fwd = ccf.LookVector
    local right = ccf.RightVector
    if UIS:IsKeyDown(Enum.KeyCode.W) then move = move + fwd end
    if UIS:IsKeyDown(Enum.KeyCode.S) then move = move - fwd end
    if UIS:IsKeyDown(Enum.KeyCode.A) then move = move - right end
    if UIS:IsKeyDown(Enum.KeyCode.D) then move = move + right end
    if UIS:IsKeyDown(Enum.KeyCode.Space) then
        move = move + Vector3.new(0, 1, 0) * (C.flyVertical / C.flySpeed)
    end
    if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
        move = move - Vector3.new(0, 1, 0) * (C.flyVertical / C.flySpeed)
    end
    if move.Magnitude > 0 then move = move.Unit * C.flySpeed end
    return move
end

-- Fast reload — через событие, а не опрос
local function setupFastReload()
    if fastReloadConn then fastReloadConn:Disconnect(); fastReloadConn = nil end
    if not C.fastReload then return end
    local hum = cachedHum
    if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then return end
    fastReloadConn = animator.AnimationPlayed:Connect(function(track)
        if not C.fastReload then return end
        if track.Animation and track.Animation.Name then
            local n = track.Animation.Name:lower()
            if n:find("reload") then
                pcall(function() track:AdjustSpeed(C.fastReloadSpeed) end)
            end
        end
    end)
end

