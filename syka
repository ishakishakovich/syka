RS.Heartbeat:Connect(function(dt)
    if not _G.__azraeell_loaded then return end

    local char, hrp, hum = getMyChar()
    if not char or not hrp or not hum then return end

    -- no slowdown
    if C.noSlowdownEnabled and hum.Health > 0 then
        if hum.WalkSpeed < C.noSlowdownSpeed then
            hum.WalkSpeed = C.noSlowdownSpeed
        end
    end

    -- fast stop
    if C.fastStop and hum.Health > 0 then
        local st = hum:GetState()
        local onG = st == Enum.HumanoidStateType.Running or st == Enum.HumanoidStateType.Landed
        if onG and hum.MoveDirection.Magnitude < 0.01 then
            local v = hrp.AssemblyLinearVelocity
            if math.abs(v.X) > 0.5 or math.abs(v.Z) > 0.5 then
                hrp.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
            end
        end
    end

    -- fast reload
    if C.fastReload then
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            local tracks = animator:GetPlayingAnimationTracks()
            for _, track in ipairs(tracks) do
                if track.Animation and track.Animation.Name then
                    local n = track.Animation.Name:lower()
                    if n:find("reload") or n:find("reloadanim") then
                        if track.Speed ~= C.fastReloadSpeed then
                            track:AdjustSpeed(C.fastReloadSpeed)
                        end
                    end
                end
            end
        end
    end

    -- fly
    if flyActive and hum.Health > 0 then
        local target = getFlyTarget()
        flyVel = flyVel:Lerp(target, math.min(dt * C.flySmooth, 1))
        hrp.AssemblyLinearVelocity = flyVel
    end

    -- lock
    if C.mode == "hold" then locked = isLockKeyDown() end
    local count = countSelected()

    if not locked then
        statusLbl.Text = "IDLE" .. (count > 0 and (" // " .. count .. " TRG") or "")
        statusLbl.TextColor3 = COL_DIM
        statusStroke.Color = COL_DANGER
        statusStroke.Transparency = 0.5
        dot.Visible = false
        arrow.Visible = false
        hpFrame.Visible = false
        lastTargetName = nil
        lastTargetHp = nil
        return
    end

    if count == 0 then
        statusLbl.Text = "LOCK // NO TRG"
        statusLbl.TextColor3 = COL_DANGER
        statusStroke.Color = COL_DANGER
        dot.Visible = false
        arrow.Visible = false
        hpFrame.Visible = false
        return
    end

    -- auto tab switch: если все мертвы, сбрасываем индекс
    local alive = getSortedAlive()
    if #alive == 0 then
        statusLbl.Text = "LOCK // ALL DEAD"
        statusLbl.TextColor3 = COL_DANGER
        statusStroke.Color = COL_DANGER
        dot.Visible = false
        arrow.Visible = false
        hpFrame.Visible = false
        return
    end

    if C.autoTabSwitch and cycleIndex > #alive then
        cycleIndex = 1
    end

    local part, tplr, dist = findNearestTarget()
    if not part then
        statusLbl.Text = "LOCK // NO TRG"
        statusLbl.TextColor3 = COL_DANGER
        dot.Visible = false
        arrow.Visible = false
        hpFrame.Visible = false
        return
    end

    statusLbl.Text = "LOCK // " .. tplr.Name
    statusLbl.TextColor3 = COL_SUCCESS
    statusStroke.Color = COL_SUCCESS
    statusStroke.Transparency = 0.2

    -- hp
    if C.showHpBar and tplr.Character then
        local th = tplr.Character:FindFirstChildOfClass("Humanoid")
        if th then
            hpFrame.Visible = true
            local ratio = math.clamp(th.Health / math.max(th.MaxHealth, 1), 0, 1)
            hpBarFill.Size = UDim2.new(ratio, 0, 1, 0)
            hpBarText.Text = math.floor(th.Health) .. "/" .. math.floor(th.MaxHealth)

            local col = COL_SUCCESS
            if ratio < 0.5 then col = Color3.fromRGB(240, 200, 80) end
            if ratio < 0.25 then col = COL_DANGER end
            hpBarFill.BackgroundColor3 = col

            local armorStr = ""
            if C.showArmor then
                local arm = getArmor(tplr)
                if arm then armorStr = " // arm " .. math.floor(arm) end
            end
            hpTop.Text = tplr.Name .. armorStr
            hpStroke.Color = col

            -- hitmarker + sound
            if lastTargetName ~= tplr.Name then
                lastTargetName = tplr.Name
                lastTargetHp = th.Health
            else
                if lastTargetHp and th.Health < lastTargetHp - 0.5 then
                    if tick() - lastSoundAt > 0.1 then
                        lastSoundAt = tick()
                        showHitmarker()
                        playHitSound()
                    end
                end
                lastTargetHp = th.Health
            end
        end
    else
        hpFrame.Visible = false
    end

    local sp, onScreen = cam:WorldToViewportPoint(part.Position)

    if C.showDot and onScreen then
        dot.Visible = true
        dot.Position = UDim2.new(0, sp.X, 0, sp.Y)
    else
        dot.Visible = false
    end

    if C.showArrow and not onScreen then
        arrow.Visible = true
        local vp = cam.ViewportSize
        local sc = Vector2.new(vp.X / 2, vp.Y / 2)
        local dir = Vector2.new(sp.X - sc.X, sp.Y - sc.Y)
        if dir.Magnitude < 0.01 then dir = Vector2.new(0, 1) end
        dir = dir.Unit
        arrow.Rotation = math.deg(math.atan2(dir.Y, dir.X)) + 90
        local r = math.min(vp.X, vp.Y) * 0.35
        local ap = sc + dir * r
        arrow.Position = UDim2.new(0, ap.X, 0, ap.Y)
    else
        arrow.Visible = false
    end
end)

-- camera lerp
RS.RenderStepped:Connect(function(dt)
    if not _G.__azraeell_loaded then return end
    if cam and cam.FieldOfView ~= C.fov then cam.FieldOfView = C.fov end
    if not locked then return end

    local _, _, hum = getMyChar()
    if not hum then return end
    local part = findNearestTarget()
    if not part then return end

    local desired = CFrame.lookAt(cam.CFrame.Position, part.Position)
    local a = math.clamp(dt * 60 * (1 / math.max(C.smooth, 0.01)), 0, 1)
    cam.CFrame = cam.CFrame:Lerp(desired, a)
end)

