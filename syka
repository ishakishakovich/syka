            badge.TextColor3 = Color3.fromRGB(10, 14, 10)
        else
            row.BackgroundTransparency = 1
            name.TextColor3 = Color3.fromRGB(230, 240, 230)
            info.TextColor3 = COL_ACCENT2
            badge.Text = ""
        end
    end

    row.MouseButton1Click:Connect(function()
        C.selectedName = p.Name
        for n, r in pairs(listRows) do
            r.setActive(n == p.Name)
        end
    end)

    listRows[p.Name] = {
        btn = row,
        setActive = setActive,
        info = info,
        player = p,
    }
end

local function refreshList()
    for n, r in pairs(listRows) do
        pcall(function() r.btn:Destroy() end)
        listRows[n] = nil
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= plr then
            buildRow(p)
        end
    end
    if C.selectedName and listRows[C.selectedName] then
        listRows[C.selectedName].setActive(true)
    end
end

refreshList()
Players.PlayerAdded:Connect(function() task.wait(0.5); refreshList() end)
Players.PlayerRemoving:Connect(function(p)
    if C.selectedName == p.Name then
        C.selectedName = nil
        locked = false
    end
    task.wait(0.3)
    refreshList()
end)

-- HP update every 0.5s
