-- ===== ESP =====
local espFolders = {}
local function destroyESP(p)
    local f = espFolders[p]
    if f then pcall(function() f:Destroy() end); espFolders[p] = nil end
end
local function createESP(p, ch)
    if espFolders[p] then return espFolders[p] end
    local head = ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")
    if not head then return nil end
    local bb = Instance.new("BillboardGui")
    bb.Name = "sykaESP"; bb.Size = UDim2.new(0, 120, 0, 80)
    bb.StudsOffset = Vector3.new(0, 2.5, 0); bb.AlwaysOnTop = true
    bb.Adornee = head; bb.Parent = head
    local nameLbl = Instance.new("TextLabel")
    nameLbl.Name = "NameLbl"; nameLbl.Size = UDim2.new(1, 0, 0, 20)
    nameLbl.BackgroundTransparency = 1; nameLbl.TextColor3 = Color3.fromRGB(255, 80, 80)
    nameLbl.Font = Enum.Font.GothamBold; nameLbl.TextSize = 14
    nameLbl.TextStrokeTransparency = 0.3; nameLbl.Text = p.Name; nameLbl.Parent = bb
    local distLbl = Instance.new("TextLabel")
    distLbl.Name = "DistLbl"; distLbl.Size = UDim2.new(1, 0, 0, 18)
    distLbl.Position = UDim2.new(0, 0, 0, 20); distLbl.BackgroundTransparency = 1
    distLbl.TextColor3 = Color3.fromRGB(220, 220, 220); distLbl.Font = Enum.Font.Gotham
    distLbl.TextSize = 12; distLbl.TextStrokeTransparency = 0.3; distLbl.Text = "[0]"; distLbl.Parent = bb
    local hpBg = Instance.new("Frame")
    hpBg.Name = "HpBg"; hpBg.Size = UDim2.new(0, 60, 0, 5); hpBg.Position = UDim2.new(0.5, -30, 0, 42)
    hpBg.BackgroundColor3 = Color3.fromRGB(30, 30, 30); hpBg.BorderSizePixel = 0; hpBg.Parent = bb
    Instance.new("UICorner", hpBg).CornerRadius = UDim.new(1, 0)
    local hpFill = Instance.new("Frame")
    hpFill.Name = "HpFill"; hpFill.Size = UDim2.new(1, 0, 1, 0)
    hpFill.BackgroundColor3 = Color3.fromRGB(80, 255, 80); hpFill.BorderSizePixel = 0; hpFill.Parent = hpBg
    Instance.new("UICorner", hpFill).CornerRadius = UDim.new(1, 0)
    espFolders[p] = bb; return bb
end

RS.RenderStepped:Connect(function()
    if not Cfg.ESP then
        for p in pairs(espFolders) do destroyESP(p) end
        return
    end
    local hue = (tick() % 5) / 5
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then destroyESP(p) continue end
        local ok, ch = validTarget(p)
        if not ok or not isEnemyESP(p) then destroyESP(p) continue end
        local bb = createESP(p, ch); if not bb then continue end
        local head = ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")
        if bb.Adornee ~= head then bb.Adornee = head end
        local dist = (cam.CFrame.Position - head.Position).Magnitude
        bb.NameLbl.Visible = Cfg.ESPName; bb.DistLbl.Visible = Cfg.ESPDistance; bb.HpBg.Visible = Cfg.ESPHealth
        bb.DistLbl.Text = "["..math.floor(dist).."]"
        bb.NameLbl.TextColor3 = Cfg.ESPRainbow and Color3.fromHSV(hue, 1, 1) or Color3.fromRGB(255, 80, 80)
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if hum then
            local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
            bb.HpBg.HpFill.Size = UDim2.new(pct, 0, 1, 0)
            bb.HpBg.HpFill.BackgroundColor3 = Color3.fromRGB(255*(1-pct), 255*pct, 0)
        end
    end
end)
