local partBtns = {}
local function makePartBtn(text, val, xPos, w)
    local b = Instance.new("TextButton", partRow)
    b.Size = UDim2.new(0, w, 1, 0)
    b.Position = UDim2.new(0, xPos, 0, 0)
    b.BackgroundColor3 = (C.targetPart == val) and COL_ACCENT or COL_BTN
    b.BorderSizePixel = 0
    b.Font = Enum.Font.GothamBold
    b.Text = text
    b.TextColor3 = (C.targetPart == val) and Color3.fromRGB(14, 10, 20) or Color3.fromRGB(230, 240, 230)
    b.TextSize = 11
    b.AutoButtonColor = false
    corner(b, 5)
    b.MouseButton1Click:Connect(function()
        C.targetPart = val
        clearAllHighlights()
        for _, c in ipairs(partBtns) do
            local active = (c.val == val)
            c.btn.BackgroundColor3 = active and COL_ACCENT or COL_BTN
            c.btn.TextColor3 = active and Color3.fromRGB(14, 10, 20) or Color3.fromRGB(230, 240, 230)
        end
    end)
    table.insert(partBtns, {btn = b, val = val})
end
