RS.RenderStepped:Connect(function(dt)
    if not C.enabled then return end

    if cam and cam.FieldOfView ~= C.fov then cam.FieldOfView = C.fov end

    local char = plr.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if flyActive and hrp and hum and hum.Health > 0 then
        local target = getFlyTarget()
        flyVel = flyVel:Lerp(target, math.min(dt * C.flySmooth, 1))
        hrp.AssemblyLinearVelocity = flyVel
        if hrp.AssemblyLinearVelocity.Magnitude < 0.1 and target.Magnitude < 0.1 then
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
    end

    if C.mode == "hold" then locked = isLockKeyDown() end
    local count = countSelected()

    if not locked then
        statusLbl.Text = (count > 0) and ("TARGETS " .. count .. "  •  OFF") or "LOCK OFF"
        statusLbl.TextColor3 = COL_DIM
        statusStroke.Color = COL_DANGER
        statusStroke.Transparency = 0.5
        dot.Visible = false
        arrow.Visible = false
        distLbl.Text = ""
        hpFrame.Visible = false
        lastTargetName = nil
        lastTargetHp = nil
        return
    end

    if count == 0 then
        statusLbl.Text = "LOCK  •  no targets"
        statusLbl.TextColor3 = COL_DANGER
        statusStroke.Color = COL_DANGER
        dot.Visible = false
        arrow.Visible = false
        distLbl.Text = ""
        hpFrame.Visible = false
        return
    end

    local part, tplr, dist = findNearestTarget()

    if not part then
        statusLbl.Text = "LOCK  •  " .. count .. " targets (none alive)"
        statusLbl.TextColor3 = COL_DANGER
        statusStroke.Color = COL_DANGER
        dot.Visible = false
        arrow.Visible = false
        distLbl.Text = ""
        hpFrame.Visible = false
        return
    end

    statusLbl.Text = "LOCK  •  " .. tplr.Name
    statusLbl.TextColor3 = COL_SUCCESS
    statusStroke.Color = COL_SUCCESS
    statusStroke.Transparency = 0.2

    if C.showHpBar and tplr and tplr.Character then
        local th = tplr.Character:FindFirstChildOfClass("Humanoid")
        if th then
            hpFrame.Visible = true
            local hpRatio = math.clamp(th.Health / math.max(th.MaxHealth, 1), 0, 1)
            hpBarFill.Size = UDim2.new(hpRatio, 0, 1, 0)
            hpBarText.Text = string.format("%d/%d", math.floor(th.Health), math.floor(th.MaxHealth))

            local hpCol = Color3.fromRGB(0, 230, 150)
            if hpRatio < 0.5 then hpCol = Color3.fromRGB(255, 200, 80) end
            if hpRatio < 0.25 then hpCol = COL_DANGER end
            hpBarFill.BackgroundColor3 = hpCol

            local armorStr = ""
            if C.showArmor then
                local arm = getArmor(tplr)
                if arm then armorStr = "  •  ARM " .. math.floor(arm) end
            end
            hpTop.Text = tplr.Name .. armorStr
            hpStroke.Color = hpCol

            if lastTargetName ~= tplr.Name then
                lastTargetName = tplr.Name
                lastTargetHp = th.Health
            else
                if lastTargetHp and th.Health < lastTargetHp - 0.5 then
                    if tick() - lastSoundAt > 0.12 then
                        lastSoundAt = tick()
                        playHitSound()
                    end
                end
                lastTargetHp = th.Health
            end
        end
    else
        hpFrame.Visible = false
    end

    if not cam then return end
    local sp, onScreen = cam:WorldToViewportPoint(part.Position)

    if C.showDot and onScreen then
        dot.Visible = true
        dot.Position = UDim2.new(0, sp.X, 0, sp.Y)
    else
        dot.Visible = false
    end

    if C.showDistance then
        distLbl.Text = math.floor(dist) .. " st"
    else
        distLbl.Text = ""
    end

    if C.showArrow and not onScreen then
        arrow.Visible = true
        local vp = cam.ViewportSize
        local sc = Vector2.new(vp.X / 2, vp.Y / 2)
        local dir = Vector2.new(sp.X - sc.X, sp.Y - sc.Y)
        if dir.Magnitude < 0.01 then dir = Vector2.new(0, 1) end
        dir = dir.Unit
        arrow.Rotation = math.deg(math.atan2(dir.Y, dir.X)) + 90
        local r = math.min(vp.X, vp.Y) * 0.35
        local ap = sc + dir * r
        arrow.Position = UDim2.new(0, ap.X, 0, ap.Y)
    else
        arrow.Visible = false
    end

    local desired = CFrame.lookAt(cam.CFrame.Position, part.Position)
    local a = math.clamp(dt * 60 * (1 / math.max(C.smooth, 0.01)), 0, 1)
    cam.CFrame = cam.CFrame:Lerp(desired, a)
end)

