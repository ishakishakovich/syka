-- ============================================================
-- HELPERS
-- ============================================================
local function getTargetPart(char)
    if not char then return nil end
    return char:FindFirstChild(C.targetPart)
        or char:FindFirstChild("Head")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("HumanoidRootPart")
end

local function valid(p)
    if not p then return false end
    if p == plr then return false end
    if C.teamCheck and plr.Team and p.Team == plr.Team then return false end
    local c = p.Character
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h then return false end
    if C.ignoreDead and h.Health <= 0 then return false end
    return true
end

local function isLockKeyDown()
    if C.lockButton == "E" then return UIS:IsKeyDown(Enum.KeyCode.E)
    elseif C.lockButton == "RMB" then return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    elseif C.lockButton == "Q" then return UIS:IsKeyDown(Enum.KeyCode.Q) end
    return false
end

local function countSelected()
    local n = 0
    for _ in pairs(C.selectedNames) do n = n + 1 end
    return n
end

local function findNearestTarget()
    local camPos = cam.CFrame.Position
    local bestPart, bestPlr, bestDist = nil, nil, math.huge
    for name, _ in pairs(C.selectedNames) do
        local p = Players:FindFirstChild(name)
        if p and valid(p) then
            local part = getTargetPart(p.Character)
            if part then
                local d = (part.Position - camPos).Magnitude
                if d < bestDist then
                    bestDist = d
                    bestPart = part
                    bestPlr = p
                end
            end
        end
    end
    return bestPart, bestPlr, bestDist
end

-- ============================================================
-- FLY
-- ============================================================
local function getFlyTarget()
    local camCF = cam.CFrame
    local move = Vector3.zero
    local fwd = camCF.LookVector
    local right = camCF.RightVector

    if UIS:IsKeyDown(Enum.KeyCode.W) then move = move + fwd end
    if UIS:IsKeyDown(Enum.KeyCode.S) then move = move - fwd end
    if UIS:IsKeyDown(Enum.KeyCode.A) then move = move - right end
    if UIS:IsKeyDown(Enum.KeyCode.D) then move = move + right end
    if UIS:IsKeyDown(Enum.KeyCode.Space) then
        move = move + Vector3.new(0, 1, 0) * (C.flyVertical / C.flySpeed)
    end
    if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
        move = move - Vector3.new(0, 1, 0) * (C.flyVertical / C.flySpeed)
    end

    if move.Magnitude > 0 then
        move = move.Unit * C.flySpeed
    end
    return move
end

-- ============================================================
-- HIGHLIGHTS
-- ============================================================
local function updateHighlights()
    for name, h in pairs(highlights) do
        local p = Players:FindFirstChild(name)
        local shouldRemove = true
        if p and C.selectedNames[name] and valid(p) and p.Character then
            if h.Parent == p.Character then
                shouldRemove = false
            end
        end
        if shouldRemove then
            pcall(function() h:Destroy() end)
            highlights[name] = nil
        end
    end
    if not C.showHighlight then return end
    for name, _ in pairs(C.selectedNames) do
        local p = Players:FindFirstChild(name)
        if p and valid(p) and p.Character and not highlights[name] then
            local h = Instance.new("Highlight")
            h.Adornee = p.Character
            h.FillColor = COL_ACCENT
            h.OutlineColor = COL_ACCENT
            h.FillTransparency = 0.7
            h.OutlineTransparency = 0
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Parent = p.Character
            highlights[name] = h
        end
    end
end

local function clearAllHighlights()
    for name, h in pairs(highlights) do
        pcall(function() h:Destroy() end)
        highlights[name] = nil
    end
end

