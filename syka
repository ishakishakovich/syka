-- ===== ХЕЛПЕРЫ =====
local function isEnemy(other)
    if other == LP then return false end
    if Cfg.Enemies[other.Name] then return true end
    if Cfg.ESPTeamCheck and LP.Team and other.Team == LP.Team then return false end
    return true
end

local function getPart(ch, name)
    return ch:FindFirstChild(name)
        or ch:FindFirstChild("Head")
        or ch:FindFirstChild("HumanoidRootPart")
end

local function validTarget(other)
    if other == LP then return false end
    local ch = other.Character
    if not ch then return false end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return true, ch
end

local function closestToPoint(fov, partName, screenPoint)
    local best, bestD = nil, fov
    for _, other in ipairs(Players:GetPlayers()) do
        local ok, ch = validTarget(other)
        if ok and isEnemy(other) then
            local part = getPart(ch, partName)
            if part then
                local sp, on = cam:WorldToViewportPoint(part.Position)
                if on then
                    local d = (Vector2.new(sp.X, sp.Y) - screenPoint).Magnitude
                    if d < bestD then bestD, best = d, part end
                end
            end
        end
    end
    return best
end

-- ===== SILENT AIM HOOK =====
local silentTarget = nil
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if not Cfg.SilentAim or not silentTarget then
        return oldNamecall(self, ...)
    end
    local args = {...}

    if method == "Raycast" and self == workspace then
        local origin, dir = args[1], args[2]
        if typeof(origin) == "Vector3" and typeof(dir) == "Vector3" then
            args[2] = (silentTarget.Position - origin).Unit * dir.Magnitude
            return oldNamecall(self, unpack(args))
        end
    elseif method == "FindPartOnRay"
        or method == "FindPartOnRayWithIgnoreList"
        or method == "FindPartOnRayWithWhitelist" then
        local ray = args[1]
        if typeof(ray) == "Ray" then
            args[1] = Ray.new(ray.Origin,
                (silentTarget.Position - ray.Origin).Unit * 5000)
            return oldNamecall(self, unpack(args))
        end
    elseif method == "ScreenPointToRay" and self == cam then
        local oldRay = oldNamecall(self, ...)
        if typeof(oldRay) == "Ray" then
            local newDir = (silentTarget.Position - oldRay.Origin).Unit
            return Ray.new(oldRay.Origin, newDir * 5000)
        end
    end
    return oldNamecall(self, ...)
end))

-- ===== ОСНОВНОЙ ЦИКЛ =====
RS.RenderStepped:Connect(function()
    local mouse = UIS:GetMouseLocation()

    if Cfg.SilentAim and UIS:IsKeyDown(Cfg.SilentAimKey) then
        silentTarget = closestToPoint(Cfg.SilentAimFOV, Cfg.SilentAimPart, mouse)
    else
        silentTarget = nil
    end

    if Cfg.Aimbot and UIS:IsKeyDown(Cfg.AimbotKey) then
        local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
        local target = closestToPoint(Cfg.AimbotFOV, Cfg.AimbotPart, center)
        if target then
            local goal = CFrame.new(cam.CFrame.Position, target.Position)
            local sm = math.clamp(Cfg.AimbotSmooth, 0, 0.95)
            cam.CFrame = cam.CFrame:Lerp(goal, 1 - sm)
        end
    end
end)

